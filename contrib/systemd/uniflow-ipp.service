[Unit]
Description=uniFLOW IPP Server
Documentation=https://github.com/uniflow-ipp-server
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/uniflow-ipp-server --config /etc/uniflow-ipp/config.toml
Restart=always
RestartSec=5
User=root
Group=root
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

StateDirectory=uniflow-ipp
RuntimeDirectory=uniflow-ipp

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target