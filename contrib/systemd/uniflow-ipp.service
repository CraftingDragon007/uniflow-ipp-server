[Unit]
Description=uniFLOW IPP Server
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/uniflow-ipp-server --config /etc/uniflow-ipp/config.toml
Restart=always
RestartSec=5
User=uniflow-ipp
Group=uniflow-ipp
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

StateDirectory=uniflow-ipp
StateDirectoryMode=0700
RuntimeDirectory=uniflow-ipp

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/spool/uniflow-ipp

[Install]
WantedBy=multi-user.target